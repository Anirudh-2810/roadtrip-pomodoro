# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ... # server only, never NEXT_PUBLIC, never commit

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM=Roadtrip Focus <onboarding@resend.dev> # verify domain for production (SPF/DKIM/DMARC)

# Auth — generate: openssl rand -base64 32
AUTH_SECRET=your-32+char-secret # also used as CSRF_SECRET fallback — rotate independently if needed
CSRF_SECRET=your-32+char-csrf-secret # optional, falls back to AUTH_SECRET

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# DDoS / rate-limit — Upstash Redis (optional, falls back to in-memory)
# Get at https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...
